# Publication allowlist: keep local experiments without adding them to Git.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/requirements.txt

# Only Python source from the model and its required backbone implementation.
!/alclo/
/alclo/**
!/alclo/**/
!/alclo/**/*.py
!/crmark/
/crmark/**
!/crmark/**/
!/crmark/**/*.py

# Only maintained training and evaluation entry points.
!/scripts/
/scripts/*
!/scripts/train_phase1.py
!/scripts/train_phase2.py
!/scripts/train_phase2_gray.py
!/scripts/train_phase3.py
!/scripts/train_phase3_gray.py
!/scripts/evaluate.py
!/scripts/evaluate_gray.py

# Baselines, tests, plots, local research and generated artifacts stay local.
Baseline/
baseline/
test/
tests/
test_*.py
*_test.py
paint/
realflow_compare/
research/
doc/
images/
outputs/
pretrain/
checkpoints/
logs/
tmp/
temp/
__pycache__/
*.py[cod]
*.pth
*.pt
*.ckpt
*.onnx
*.safetensors
*.log
events.out.tfevents.*
*.tmp
*.bak
*.swp
.env
.env.*
*.pem
*.key
.idea/
.vscode/
.claude/
.codex/
.codex_tmp/
.venv/
venv/
.DS_Store
Thumbs.db
